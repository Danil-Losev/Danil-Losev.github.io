---
interface Props {
  title: string;
  description?: string;
  category: string;
  date: Date;
  slug: string;
  tags?: string[];
}

const {
  title,
  description,
  category,
  date,
  slug,
  tags = [],
} = Astro.props;

const searchTitle = title.toLowerCase();
const searchTags = tags.map((tag) => tag.toLowerCase()).join("|");
---

<a
  href={`/blog/${slug}/`}
  class="post-card"
  data-title={searchTitle}
  data-tags={searchTags}
>
  <time class="post-date">
    {date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })}
  </time>

  <div>
    <div class="post-category">
      {category}
    </div>

    <h2 class="post-title">
      {title}
    </h2>

    {
      description && (
        <p class="post-description">
          {description}
        </p>
      )
    }

    {
      tags.length > 0 && (
        <div class="post-tags" aria-label="Article tags">
          {tags.map((tag) => (
            <span class="post-tag">#{tag}</span>
          ))}
        </div>
      )
    }
  </div>

  <span class="post-arrow">
    →
  </span>
</a>
