const iconContent = icons[name] ?? icons.folder;
---

{type === 'image' && src ? (
  <img
    src={src}
    alt={alt}
    width={size}
    height={size}
    class="project-icon-image"
  />
) : (
  <svg
    class="project-icon-svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={iconContent}
  />
)}